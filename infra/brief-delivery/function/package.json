{
  "name": "@hardmagic/brief-lock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --all --include=src/**/*.ts --reporter=text --reporter=lcov npm test"
  },
  "dependencies": {
    "@azure/abort-controller": "2.2.0",
    "@azure/communication-email": "1.1.0",
    "@azure/functions": "4.16.2",
    "@azure/identity": "4.13.1",
    "@azure/keyvault-secrets": "4.11.2",
    "@azure/storage-blob": "12.33.0",
    "@azure/storage-queue": "12.31.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "c8": "12.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
