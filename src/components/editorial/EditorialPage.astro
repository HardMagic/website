  '/services/content-operations/': { ready: '/engagements/managed-media-desk/', early: '/methods/evidence-loop/' },
  '/services/campaign-production/': { ready: '/engagements/product-launch-room/', early: '/products/studio/' },
  '/services/web-experience/': { ready: '/contact/', early: '/insights/static-websites-as-durable-media/' },
  '/services/executive-advisory/': { ready: '/contact/', early: '/methods/intent-to-system/' },

  '/engagements/transformation-sprint/': { ready: '/contact/', early: '/methods/30-60-90-activation/' },
  '/engagements/fractional-creative-office/': { ready: '/contact/creative-direction/', early: '/insights/creative-direction-after-model-abundance/' },
  '/engagements/genai-lab/': { ready: '/contact/genai/', early: '/briefs/generative-media-operating-system/' },
  '/engagements/managed-media-desk/': { ready: '/contact/media-management/', early: '/briefs/intelligent-media-asset-estate/' },
  '/engagements/product-launch-room/': { ready: '/contact/', early: '/products/studio/' },

  '/industries/media-entertainment/': { ready: '/contact/media-management/', early: '/products/studio/' },
  '/industries/consumer-brands/': { ready: '/contact/marketing-consulting/', early: '/methods/brand-memory/' },
  '/industries/sports-wellness/': { ready: '/contact/creative-direction/', early: '/insights/creative-direction-after-model-abundance/' },
  '/industries/agencies/': { ready: '/engagements/genai-lab/', early: '/briefs/generative-media-operating-system/' },
  '/industries/software-platforms/': { ready: '/engagements/product-launch-room/', early: '/products/wiremark/' },
  '/industries/retail-commerce/': { ready: '/contact/media-management/', early: '/products/photo-curator/' },
  '/industries/education-culture/': { ready: '/contact/genai/', early: '/insights/provenance-without-killing-creative-flow/' },
  '/industries/founder-led-companies/': { ready: '/contact/marketing-consulting/', early: '/insights/marketing-operations-for-small-expert-teams/' },

  '/methods/intent-to-system/': { ready: '/engagements/transformation-sprint/', early: '/briefs/generative-media-operating-system/' },
  '/methods/evidence-loop/': { ready: '/engagements/transformation-sprint/', early: '/products/web-magic/delivery/' },
  '/methods/hybrid-inference/': { ready: '/contact/genai/', early: '/briefs/hybrid-ai-media-infrastructure/' },
  '/methods/collection-to-intelligence/': { ready: '/contact/media-management/', early: '/briefs/intelligent-media-asset-estate/' },
  '/methods/accessibility-as-editorial/': { ready: '/contact/', early: '/products/web-magic/accessibility/' },
  '/methods/human-agent-creative-loop/': { ready: '/contact/genai/', early: '/products/cli/agent-skills/' },
  '/methods/brand-memory/': { ready: '/services/brand-systems/', early: '/insights/brand-memory-in-generative-systems/' },
  '/methods/30-60-90-activation/': { ready: '/engagements/genai-lab/', early: '/briefs/generative-media-operating-system/' },

  '/insights/creative-direction-after-model-abundance/': { ready: '/contact/creative-direction/', early: '/briefs/creative-direction-after-the-prompt/' },
  '/insights/the-running-product-is-the-brief/': { ready: '/contact/', early: '/products/wiremark/' },
  '/insights/from-prompting-to-production-systems/': { ready: '/contact/genai/', early: '/briefs/provenance-ready-content-supply-chain/' },
  '/insights/hybrid-inference-is-a-governance-decision/': { ready: '/contact/genai/', early: '/methods/hybrid-inference/' },
  '/insights/why-media-collections-lose-their-value/': { ready: '/contact/media-management/', early: '/briefs/intelligent-media-asset-estate/' },
  '/insights/accessibility-is-art-direction/': { ready: '/contact/', early: '/methods/accessibility-as-editorial/' },
  '/insights/the-case-for-agent-readable-creative-operations/': { ready: '/contact/genai/', early: '/methods/human-agent-creative-loop/' },
  '/insights/brand-memory-in-generative-systems/': { ready: '/services/brand-systems/', early: '/methods/brand-memory/' },
  '/insights/what-a-modern-media-control-room-needs/': { ready: '/engagements/managed-media-desk/', early: '/products/photo-curator/' },
  '/insights/how-to-evaluate-a-genai-pilot/': { ready: '/engagements/genai-lab/', early: '/briefs/generative-media-operating-system/' },
  '/insights/the-cost-of-model-first-product-design/': { ready: '/contact/', early: '/products/wiremark/' },
  '/insights/provenance-without-killing-creative-flow/': { ready: '/contact/', early: '/products/wiremark/privacy-provenance/' },
  '/insights/static-websites-as-durable-media/': { ready: '/services/web-experience/', early: '/products/web-magic/' },
  '/insights/marketing-operations-for-small-expert-teams/': { ready: '/contact/marketing-consulting/', early: '/methods/30-60-90-activation/' },
  '/insights/25-years-from-brand-studio-to-ai-company/': { ready: '/contact/', early: '/products/' },

  '/company/history/': { ready: '/contact/', early: '/company/' },
  '/company/founder/': { ready: '/contact/', early: '/insights/25-years-from-brand-studio-to-ai-company/' },
  '/company/principles/': { ready: '/contact/', early: '/methods/brand-memory/' },
  '/company/selected-experience/': { ready: '/contact/', early: '/portfolio/' },
  '/company/operating-model/': { ready: '/engagements/', early: '/methods/intent-to-system/' },
  '/company/partners/': { ready: '/contact/partnerships/', early: '/company/operating-model/' },
  '/company/careers/': { ready: '/contact/', early: '/company/principles/' },

  '/contact/': { ready: '/contact/#intake', early: '/engagements/' },
  '/contact/creative-direction/': { ready: '/contact/creative-direction/#intake', early: '/insights/creative-direction-after-model-abundance/' },
  '/contact/genai/': { ready: '/contact/genai/#intake', early: '/briefs/generative-media-operating-system/' },
  '/contact/media-management/': { ready: '/contact/media-management/#intake', early: '/methods/collection-to-intelligence/' },
  '/contact/marketing-consulting/': { ready: '/contact/marketing-consulting/#intake', early: '/insights/marketing-operations-for-small-expert-teams/' },
  '/contact/partnerships/': { ready: '/contact/partnerships/#intake', early: '/company/operating-model/' },
  '/contact/thanks/': { ready: '/contact/', early: '/insights/' },

  '/privacy/': { ready: '/contact/', early: '/responsible-ai/' },
  '/accessibility/': { ready: '/contact/', early: '/methods/accessibility-as-editorial/' },
  '/responsible-ai/': { ready: '/contact/genai/', early: '/briefs/provenance-ready-content-supply-chain/' },
  '/security/': { ready: '/contact/', early: '/products/cli/security/' },
  '/terms/': { ready: '/contact/', early: '/company/' },
  '/editorial-policy/': { ready: '/contact/', early: '/insights/' },
  '/sitemap/': { ready: '/contact/', early: '/methods/' },
};

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const routeHref = (path: string) => path.startsWith('#') ? path : `${baseUrl}${path.replace(/^\/+/, '')}`;
const ctaPaths = { ...familyCtaPaths[page.family], ...(routeCtaOverrides[page.path] ?? {}) };
const primaryHref = routeHref(ctaPaths.ready);
const earlyHref = routeHref(ctaPaths.early);
const imageByFamily = {
  product: hybridInfrastructure,
  service: creativeDirection,
  engagement: creativeDirection,
  industry: generativeOperations,
  method: dreamMedia,
  insight: dreamMedia,
  company: generativeOperations,
  contact: creativeDirection,
  trust: hybridInfrastructure,
  'front-door': generativeOperations,
} as const;
const atmosphericImages = [mediaAlchemy, archiveCathedral, audienceDreamfield] as const;
const routeSeed = [...page.path].reduce((total, character) => total + character.charCodeAt(0), 0);
const isImmersive = ['insight', 'method', 'industry'].includes(page.family) && routeSeed % 2 === 0;
const magicalInterludePaths = new Set([
  '/services/creative-direction/',
  '/services/marketing-consulting/',
  '/services/brand-systems/',
  '/services/campaign-production/',
  '/company/history/',
  '/company/principles/',
  '/insights/25-years-from-brand-studio-to-ai-company/',
]);
const showMagicalInterlude = magicalInterludePaths.has(page.path);
const leadImage = isImmersive
  ? atmosphericImages[routeSeed % atmosphericImages.length] ?? mediaAlchemy
  : imageByFamily[page.family as keyof typeof imageByFamily] ?? dreamMedia;
const familyLabel = page.family.replaceAll('-', ' ');
const related = page.relatedPaths.map((path) => path.replace(/^\//, '') || './');
const isContact = page.family === 'contact' && !page.path.endsWith('/thanks/');
const showEnterpriseCta = !['contact', 'trust', 'brief-confirmation'].includes(page.family);
const transitionFamilies = new Set<EditorialFamily>(['product', 'service', 'engagement', 'industry', 'method', 'insight', 'company']);
const transitionAction = transitionFamilies.has(page.family)
  ? {
      href: ['service', 'engagement', 'industry', 'company'].includes(page.family) ? primaryHref : earlyHref,
      label: ['service', 'engagement', 'industry', 'company'].includes(page.family) ? page.primaryAction : page.earlyAction,
      eyebrow: ['service', 'engagement', 'industry', 'company'].includes(page.family) ? 'Apply this question' : 'Keep tracing the question',
    }
  : null;
---
<BaseLayout title={page.title} description={page.deck} turnstile={isContact} noindex={page.path.endsWith('/thanks/')}>
  <article class={`editorial-page family-${page.family}`}>
    <header class:list={['editorial-hero', { shell: !isImmersive, 'editorial-hero-immersive': isImmersive }] }>
      <div class="editorial-hero-copy">
        <p class:list={['eyebrow', { dark: !isImmersive }]}>HardMagic / {familyLabel}</p>
        <p class="issue-line">Field note · 2026.08 · {page.topics[0]}</p>
        <h1>{page.title}</h1>
        <p class="editorial-deck">{page.deck}</p>
        <div class="editorial-actions">
          <a class:list={['button', { 'dark-button': !isImmersive, ghost: isImmersive }]} href={primaryHref}>{page.primaryAction}</a>
          <a class="text-link" href={earlyHref}>{page.earlyAction} <b>↗</b></a>
        </div>
      </div>
      <figure class="editorial-lead-art">
        <Picture src={leadImage} alt="A conceptual HardMagic editorial composition illustrating creative and technical systems." formats={[]} fallbackFormat="avif" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 48vw" loading="eager" />
        <figcaption>AI-generated conceptual artwork, selected and art-directed by HardMagic; scenario art, not product, infrastructure, client, or performance evidence.</figcaption>
      </figure>
    </header>

    <section class="thesis-band" id="decision">
      <div class="shell">
        <p>Position / 01</p>
        <blockquote>{page.thesis}</blockquote>
      </div>
    </section>

    <section class="editorial-spread shell section-pad" id="field-notes">
      <aside>
        <p class="eyebrow dark">Reader assignment</p>
        <h2>{page.readerJob}</h2>
        <dl>
          {page.topics.map((topic, index) => <div><dt>0{index + 1}</dt><dd>{topic}</dd></div>)}
        </dl>
      </aside>
      <div class="editorial-sections">
        {page.sections.map((section, index) => (
          <section>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.heading}</h2>
            {section.copy?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {index === 2 && transitionAction && (
              <p class="section-transition">
                <span>{transitionAction.eyebrow}</span>
                <a href={transitionAction.href}>{transitionAction.label} <b aria-hidden="true">↗</b></a>
              </p>
            )}
          </section>
        ))}
      </div>
    </section>

    {showMagicalInterlude && (
      <MysticalInterlude id={`threshold-${routeSeed}`} title="Speak with enough clarity, and the future has somewhere to arrive." eyebrow="HardMagic / Abracadabra" tone={routeSeed % 3 === 0 ? 'spectral' : 'nocturne'} motif={routeSeed % 3 === 0 ? 'oracle' : 'threshold'}>
        <p>Words give imagination a form other people can enter. Our version of the spell is practical: {page.thesis}</p>
        <a slot="footer" class="button ghost" href="horizon/">Read Horizon 2035</a>
      </MysticalInterlude>
    )}

    <section class="visual-essay shell">
      <EditorialVisual family={page.family} modes={page.visualModes} topics={page.topics} />
      <div>
        <p class="eyebrow dark">Operating view</p>
        <h2>Make the invisible structure visible.</h2>
        <p>HardMagic works in systems: who decides, what evidence travels with the work, where intelligence runs, and how an idea survives the journey into production. This diagram is conceptual—not a claim of measured product performance.</p>
      </div>
    </section>

    {isContact && (
      <section class="intake-band" id="intake">
        <form class="intake-form shell" method="post" action="https://briefs.hardmagic.com/api/contact-request" data-funnel-form="contact" aria-describedby="editorial-contact-privacy">
          <div>
            <p class="eyebrow">A focused first conversation</p>
            <h2>Tell us where the decision is stuck.</h2>
            <p id="editorial-contact-privacy">Do not include credentials, customer records, unreleased financial information, or regulated personal data.</p>
          </div>
          <div class="form-grid">
            <label>Name<input required name="name" autocomplete="name" maxlength="160" /></label>
            <label>Work email<input required type="email" name="email" autocomplete="email" maxlength="320" /></label>
            <label>Organization<input required name="organization" autocomplete="organization" maxlength="200" /></label>
            <label>Role<input required maxlength="120" name="role" autocomplete="organization-title" /></label>
            <label class="wide">Area<select name="intake_category" required><option value="">Choose one</option><option value="creative-direction">Creative direction</option><option value="genai">GenAI strategy and production</option><option value="media-management">Media management</option><option value="marketing-consulting">Marketing consulting</option><option value="product-strategy">Product strategy</option><option value="creative-technology">Creative technology</option></select></label>
            <label class="wide">What decision are you facing?<textarea required name="mandate" rows="5" maxlength="4000"></textarea></label>
            <label>Decision horizon<select required name="decision_horizon"><option value="">Choose a horizon</option><option>Now–30 days</option><option>31–90 days</option><option>3–6 months</option><option>6–12 months</option></select></label>
            <label>Preferred next step<select required name="preferred_next_step"><option value="">Choose a next step</option><option>Written response</option><option>Working session</option><option>Advisory engagement</option><option>Product discussion</option></select></label>
            <label class="consent wide"><input type="checkbox" name="consent" value="yes" required /> I agree that HardMagic may use this information to respond to this request. This does not subscribe me to marketing.</label>
            <input type="hidden" name="marketing_consent" value="no" />
            <label class="consent wide optional"><input type="checkbox" name="marketing_consent" value="yes" /> Separately, I would like occasional HardMagic research and product updates.</label>
            <div class="cf-turnstile wide" data-sitekey="0x4AAAAAAEOV4a4wcfxluMkv" data-theme="dark" data-action="contact-request" data-response-field-name="cf-turnstile-response"></div>
            <noscript><p class="wide">JavaScript is required for the protected form check. Send a high-level note directly to <a href="mailto:hello@hardmagic.com">hello@hardmagic.com</a> instead; please do not include confidential or regulated information.</p></noscript>
            <input type="hidden" name="request_id" value="" autocomplete="off" />
            <input type="hidden" name="source_url" value={`https://hardmagic.com${page.path}`} />
            <input type="hidden" name="source_campaign" value="corporate-intake" />
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
            <button class="button" type="submit">Send inquiry</button>
          </div>
        </form>
      </section>
    )}

    {isContact && <script is:inline src="scripts/corporate-email-validation.js"></script>}

    <nav class="related-reading shell section-pad" aria-label="Related reading">
      <p class="eyebrow dark">Continue the issue</p>
      <h2>Follow the system.</h2>
      <div>{related.map((path, index) => <a href={path}><span>0{index + 1}</span>{path.replaceAll('-', ' ').replaceAll('/', ' / ')}</a>)}</div>
    </nav>

    {showEnterpriseCta && (
      <section class="enterprise-cta" aria-labelledby="enterprise-cta-title">
        <div class="enterprise-cta-inner shell">
          <div class="enterprise-cta-intro">
            <p class="eyebrow">The next useful depth</p>
            <h2 id="enterprise-cta-title">Choose the path that fits the decision.</h2>
            <p>{page.readerJob} If the question has an owner and a horizon, take the working path. If it still needs language, keep building context first.</p>
          </div>
          <div class="enterprise-cta-options">
            <a class="enterprise-cta-option" href={primaryHref}>
              <span>Ready to move</span>
              <strong>{page.primaryAction}</strong>
              <small>Use the relevant intake or engagement route.</small>
            </a>
            <a class="enterprise-cta-option" href={earlyHref}>
              <span>Still framing the question</span>
              <strong>{page.earlyAction}</strong>
              <small>Continue through a relevant brief, insight, method, or product.</small>
            </a>
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .section-transition {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 22px;
    margin: 30px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgba(242, 233, 223, 0.16);
  }

  .section-transition span {
    color: var(--mist);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-transition a {
    color: var(--bone);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .section-transition a b {
