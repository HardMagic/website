---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialVisual from './EditorialVisual.astro';
import MysticalInterlude from '../atmosphere/MysticalInterlude.astro';
import type { EditorialFamily, EditorialRoute } from '../../data/editorial';
import generativeOperations from '../../assets/editorial/generative-operations-4k.avif';
import creativeDirection from '../../assets/editorial/creative-direction.png';
import hybridInfrastructure from '../../assets/editorial/hybrid-infrastructure.png';
import dreamMedia from '../../assets/editorial/dream-media-specimen-4k.avif';
import mediaAlchemy from '../../assets/editorial/media-alchemy-ritual-4k.avif';
import archiveCathedral from '../../assets/editorial/archive-cathedral-2035.avif';
import audienceDreamfield from '../../assets/editorial/audience-dreamfield-2035-4k.avif';

interface Props { page: EditorialRoute }
const { page } = Astro.props;

interface RouteCtaPaths {
  ready: string;
  early: string;
}

const familyCtaPaths: Record<EditorialFamily, RouteCtaPaths> = {
  'front-door': { ready: '/contact/', early: '/portfolio/' },
  product: { ready: '/contact/', early: '/briefs/generative-media-operating-system/' },
  service: { ready: '/contact/', early: '/methods/' },
  engagement: { ready: '/contact/', early: '/methods/' },
  industry: { ready: '/contact/', early: '/briefs/generative-media-operating-system/' },
  method: { ready: '/engagements/transformation-sprint/', early: '/insights/' },
  insight: { ready: '/contact/', early: '/methods/' },
  brief: { ready: '/briefs/', early: '/insights/' },
  'brief-confirmation': { ready: '/contact/', early: '/insights/' },
  company: { ready: '/contact/', early: '/insights/25-years-from-brand-studio-to-ai-company/' },
  contact: { ready: '/contact/#intake', early: '/insights/' },
  trust: { ready: '/contact/', early: '/responsible-ai/' },
};

const routeCtaOverrides: Record<string, Partial<RouteCtaPaths>> = {
  '/insights/': { ready: '/contact/', early: '/methods/' },
  '/services/': { ready: '/contact/', early: '/methods/' },
  '/engagements/': { ready: '/contact/', early: '/methods/' },
  '/industries/': { ready: '/contact/', early: '/briefs/generative-media-operating-system/' },
  '/methods/': { ready: '/engagements/', early: '/insights/' },

  '/products/wiremark/': { ready: '/contact/', early: '/briefs/visual-product-development-field-guide/' },
  '/products/wiremark/canvas/': { ready: '/contact/', early: '/insights/the-running-product-is-the-brief/' },
