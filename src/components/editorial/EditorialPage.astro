  '/products/cli/quickstart/': { ready: '/contact/genai/', early: '/briefs/autonomous-web-publishing-control-plane/' },
  '/products/cli/automation/': { ready: '/contact/genai/', early: '/methods/evidence-loop/' },
  '/products/cli/agent-skills/': { ready: '/contact/genai/', early: '/methods/human-agent-creative-loop/' },
  '/products/cli/security/': { ready: '/contact/genai/', early: '/briefs/autonomous-web-publishing-control-plane/' },
  '/products/web-magic/': { ready: '/contact/', early: '/insights/static-websites-as-durable-media/' },
  '/products/web-magic/accessibility/': { ready: '/contact/', early: '/methods/accessibility-as-editorial/' },
