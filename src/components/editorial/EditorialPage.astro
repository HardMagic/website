  '/products/web-magic/delivery/': { ready: '/contact/', early: '/methods/evidence-loop/' },
  '/products/photo-curator/': { ready: '/contact/media-management/', early: '/briefs/intelligent-media-asset-estate/' },
  '/products/photo-curator/review/': { ready: '/contact/media-management/', early: '/methods/collection-to-intelligence/' },
  '/products/photo-curator/duplicates/': { ready: '/contact/media-management/', early: '/methods/collection-to-intelligence/' },
