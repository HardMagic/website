  '/products/wiremark/agent-handoff/': { ready: '/contact/genai/', early: '/methods/human-agent-creative-loop/' },
  '/products/wiremark/privacy-provenance/': { ready: '/contact/', early: '/insights/provenance-without-killing-creative-flow/' },
  '/products/studio/': { ready: '/contact/genai/', early: '/briefs/generative-media-operating-system/' },
