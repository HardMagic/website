---
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  turnstile?: boolean;
  corporateEmailValidation?: boolean;
  noindex?: boolean;
}

const { title, description, image = '/og-hardmagic.svg', turnstile = false, corporateEmailValidation = false, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalPath = base !== '/' && Astro.url.pathname.startsWith(base)
  ? `/${Astro.url.pathname.slice(base.length)}`
  : Astro.url.pathname;
const canonical = new URL(canonicalPath, Astro.site);
const fullTitle = title === 'HardMagic' ? title : `${title} — HardMagic`;
const socialImage = new URL(image, Astro.site);
// This graph is assembled only from trusted route metadata and escaped before
// raw insertion so a future title cannot terminate the JSON-LD script.
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: 'HardMagic Corporation',
      url: new URL('/', Astro.site).href,
      logo: new URL('/og-hardmagic.svg', Astro.site).href,
      email: 'hello@hardmagic.com',
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: 'HardMagic',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
      inLanguage: 'en',
    },
  ],
}).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#100b0d" />
    <base href={base} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href={`${Astro.url.pathname}#main`}>Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    {corporateEmailValidation && <script is:inline src="scripts/corporate-email-validation.js"></script>}
  </body>
</html>
