---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/portfolio/CaseCard.astro';
import SonicIdent from '../../components/media/SonicIdent.astro';
import VideoArchive from '../../components/media/VideoArchive.astro';
import { caseStudies } from '../../data/portfolio';
const disciplines = [...new Set(caseStudies.flatMap((study) => study.disciplines))];
---
<BaseLayout title="Creative Direction Portfolio" description="HardMagic case studies in building coherent worlds across identity, media, software, learning, hospitality, and place.">
  <section class="portfolio-hero">
    <div class="portfolio-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="shell portfolio-hero-copy"><p class="eyebrow">Creative direction in practice</p><h1>Build the world,<br /><em>not the surface.</em></h1><p>Eight case studies across identity, media, software, learning, hospitality, and place—examined through the decisions, artifacts, and systems that shaped them.</p><a class="button ghost" href="products/">See how this practice operates now</a></div>
  </section>
  <div class="portfolio-filter shell" role="region" aria-label="Portfolio disciplines" tabindex="0"><span>Explore:</span>{disciplines.map((item) => <span class="portfolio-discipline">{item}</span>)}</div>
  <section class="portfolio-grid" aria-label="Case studies">
    {caseStudies.map((study, index) => <CaseCard study={study} index={index} />)}
  </section>
  <section class="archive-doctrine shell">
    <p class="eyebrow dark">Evidence standard</p><h2>The work is shown.<br />The record stays clear.</h2>
    <div><p>These studies show a continuous creative practice and the direct line into the systems HardMagic operates now. Available evidence, limitations, and present relevance are identified inside each case.</p><p>Documented relationships do not imply current affiliation or endorsement. Third-party marks belong to their respective owners.</p></div>
  </section>
  <SonicIdent />
  <VideoArchive />
</BaseLayout>
