---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies, type CaseStudy } from '../../data/portfolio';

export function getStaticPaths() { return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } })); }
const { study } = Astro.props as { study: CaseStudy };
const current = caseStudies.findIndex((item) => item.slug === study.slug);
const next = caseStudies[(current + 1) % caseStudies.length]!;
const currentConnections: Record<string, { label: string; href: string; statement: string }> = {
  airikai: { label: 'HardMagic Studio', href: 'products/studio/', statement: 'Movement, identity, image, and learning become a directed multimodal production system.' },
  fashionx: { label: 'HardMagic Studio', href: 'products/studio/', statement: 'Art direction now moves through generation, capture, rights, variants, and delivery in one evidence-rich workflow.' },
  focuspass: { label: 'WireMark', href: 'products/wiremark/', statement: 'The same instinct for visible progress now connects live product experience, source, agents, and verification.' },
  pedadida: { label: 'HardMagic Agent (CLI)', href: 'products/cli/', statement: 'Platform-scale thinking now becomes bounded agent workflows, typed contracts, and repeatable operations.' },
  pranashama: { label: 'HardMagic Studio', href: 'products/studio/', statement: 'One editorial system can now direct image, motion, voice, product media, and channel variants together.' },
  'state-parks': { label: 'HardMagic Studio', href: 'products/studio/', statement: 'Documentary judgment now joins spatial sound, generation, provenance, and rights-aware post-production.' },
  'tao-cottage': { label: 'Web Magic', href: 'products/web-magic/', statement: 'Experience direction now extends through accessible, measurable, and verifiable public delivery.' },
  taolo: { label: 'HardMagic Studio', href: 'products/studio/', statement: 'Material identity now expands into motion, sound, generative variations, and modular commerce storytelling.' },
};
const connection = currentConnections[study.slug]!;
---
<BaseLayout title={`${study.title} case study`} description={study.opening}>
  <article class="case-study" style={`--case-accent:${study.accent}`}>
    <header class="case-hero">
      <Picture src={study.media[0].src} alt={study.media[0].alt} formats={[]} fallbackFormat="avif" width={1600} widths={[720, 1200, 1600]} sizes="100vw" loading="eager" />
      <span class="case-hero-shade" aria-hidden="true"></span>
      <div class="case-hero-copy shell"><div class="case-hero-label"><span>Case study</span><span>{study.era}</span></div><h1>{study.title}</h1><p>{study.subtitle}</p></div>
    </header>
    <div class="case-rail shell"><a href="portfolio/">← All work</a><span>{study.disciplines.join(' · ')}</span></div>
    <section class="case-opening shell"><p class="case-kicker">The project</p><h2>{study.opening}</h2></section>
    <section class="case-spread shell">
      <div class="case-copy"><p class="eyebrow dark">Context</p>{study.context.map((text) => <p>{text}</p>)}</div>
      <figure><Picture src={study.media[1].src} alt={study.media[1].alt} formats={[]} fallbackFormat="avif" width={1280} widths={[640, 960, 1280]} sizes="(min-width: 900px) 58vw, 100vw" /><figcaption>{study.media[1].caption}</figcaption></figure>
    </section>
    <section class="case-response">
      <div class="shell"><div class="case-response-copy"><p class="eyebrow">Creative response</p><h2>Build the world,<br />not just the surface.</h2>{study.response.map((text) => <p>{text}</p>)}</div></div>
    </section>
    {study.media[2] && <figure class="case-cinema"><Picture src={study.media[2].src} alt={study.media[2].alt} formats={[]} fallbackFormat="avif" width={1600} widths={[720, 1200, 1600]} sizes="100vw" /><figcaption>{study.media[2].caption}</figcaption></figure>}
    <section class="case-lessons shell">
      <div><p class="eyebrow dark">Principles in operation</p><h2>Durable ideas,<br />actively applied.</h2></div>
      <ol>{study.survives.map((item, index) => <li><span>0{index + 1}</span>{item}</li>)}</ol>
    </section>
    <section class="case-now"><div class="shell"><p class="eyebrow">Where this capability lives now</p><h2>{study.now}</h2><p><a class="button ghost" href={connection.href}>{connection.label}</a></p><p>{connection.statement}</p></div></section>
    <aside class="archive-caveat shell"><strong>Evidence and limitations</strong><p>{study.caveat}</p></aside>
    <a class="next-case" href={`portfolio/${next.slug}/`}><span>Next case study</span><strong>{next.title}</strong><span aria-hidden="true">↗</span></a>
  </article>
</BaseLayout>
