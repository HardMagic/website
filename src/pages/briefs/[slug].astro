---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import EditorialVisual from '../../components/editorial/EditorialVisual.astro';
import { briefs, type TechnicalBrief } from '../../data/briefs';
import archiveCathedral from '../../assets/editorial/archive-cathedral-2035.avif';
import mediaAlchemy from '../../assets/editorial/media-alchemy-ritual-4k.avif';
import audienceDreamfield from '../../assets/editorial/audience-dreamfield-2035-4k.avif';

export function getStaticPaths() {
  return briefs.map((brief) => ({ params: { slug: brief.slug }, props: { brief } }));
}
interface Props { brief: TechnicalBrief }
const { brief } = Astro.props as Props;
const coverImages = [archiveCathedral, mediaAlchemy, audienceDreamfield] as const;
const coverSeed = [...brief.slug].reduce((total, character) => total + character.charCodeAt(0), 0);
const coverImage = coverImages[coverSeed % coverImages.length] ?? archiveCathedral;
const briefEvidence = brief.evidenceNeeds.map((item) => {
  const url = item.match(/https:\/\/\S+$/)?.[0];
  return { text: url ? item.slice(0, -url.length).trim() : item, url };
});
---
<BaseLayout title={brief.title} description={brief.squeeze.promise} turnstile corporateEmailValidation>
  <article class="brief-page">
    <header class="brief-hero shell">
      <div>
        <p class="eyebrow dark">HardMagic Technical Brief / {brief.pageCount} pages</p>
        <p class="issue-line">Private edition · individually delivered · access expires</p>
        <h1>{brief.title}</h1>
        <p class="editorial-deck">{brief.squeeze.promise}</p>
        <a class="button dark-button" href={`briefs/${brief.slug}/#request`}>Request the brief</a>
      </div>
      <div class="brief-cover" aria-label={`Conceptual cover for ${brief.title}`}>
        <Picture class="brief-cover-media" src={coverImage} alt="" formats={[]} fallbackFormat="avif" widths={[480,720,960]} sizes="(max-width: 900px) 90vw, 38vw" />
        <div class="brief-cover-veil"></div>
        <span>HM / TECHNICAL BRIEF</span><b>{brief.title}</b><i>{brief.pageCount}</i>
      </div>
    </header>

    <section class="thesis-band"><div class="shell"><p>Central thesis</p><blockquote>{brief.thesis}</blockquote></div></section>

    <section class="brief-preview shell section-pad">
      <div>
        <p class="eyebrow dark">The decision</p><h2>{brief.decision}</h2>
        <p>{brief.squeeze.preview}</p>
      </div>
      <div class="brief-audience"><p class="eyebrow dark">Written for</p>{brief.audience.map((item) => <span>{item}</span>)}</div>
    </section>

    <section class="brief-contents shell">
      <div class="section-heading"><div><p class="eyebrow dark">Inside the edition</p><h2>A working document,<br/>not a brochure.</h2></div><p>The public summary carries the thesis. The private edition adds the complete argument, operating diagrams, and worksheets.</p></div>
      <ol>{brief.chapters.map((chapter, index) => <li><span>{String(index + 1).padStart(2,'0')}</span><b>{chapter.title}</b><em>{chapter.pages.start === chapter.pages.end ? `p. ${chapter.pages.start}` : `pp. ${chapter.pages.start}–${chapter.pages.end}`}</em></li>)}</ol>
    </section>

    <section class="brief-instruments shell section-pad">
      <EditorialVisual family="brief" modes={brief.diagrams.slice(0,4)} topics={brief.worksheets.slice(0,3)} />
      <div><p class="eyebrow dark">Reader instruments</p><h2>Diagrams to orient. Worksheets to act.</h2><ul>{brief.worksheets.map((item) => <li>{item}</li>)}</ul></div>
    </section>

    <section class="brief-standards">
      <div class="shell">
        <div><p class="eyebrow">Evidence standard</p><h2>What this brief will—and will not—claim.</h2></div>
        <div><h3>Evidence required</h3><ul>{briefEvidence.map((item) => <li>{item.text}{item.url && <> <a href={item.url} rel="noreferrer">Inspect the primary source ↗</a></>}</li>)}</ul><h3>Limitations</h3><ul>{brief.limitations.map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </section>

    <section class="squeeze" id="request">
      <form method="post" action="https://briefs.hardmagic.com/api/brief-request" class="shell squeeze-grid" data-corporate-email-only>
        <div><p class="eyebrow">Private delivery</p><h2>{brief.squeeze.headline}</h2><p>{brief.squeeze.promise}</p><p class="privacy-note">We email a time-limited private link. The PDF is never published at a public site path. Company email required; Gmail, Yahoo, Hotmail, and Outlook.com accounts are not eligible. Do not submit secrets, regulated personal information, or confidential client material.</p></div>
        <div class="form-grid">
          <label>Name<input required name="name" autocomplete="name" /></label>
          <label>Work email<input required type="email" name="email" autocomplete="email" /><small>Company email required. Gmail, Yahoo, Hotmail, and Outlook.com accounts are not eligible.</small></label>
          <label>Organization<input required name="organization" autocomplete="organization" /></label>
          <label>Role<input required name="role" autocomplete="organization-title" /></label>
          <label>Industry<input required name="industry" /></label>
          <label>Organization size<select required name="organization_size"><option value="">Choose</option><option>1–49</option><option>50–249</option><option>250–999</option><option>1,000–9,999</option><option>10,000+</option></select></label>
          <label>Program stage<select required name="decision_stage"><option value="">Choose</option><option>Exploring</option><option>Piloting</option><option>In production</option><option>Scaling</option><option>Transforming</option></select></label>
          <label>Decision horizon<select required name="decision_horizon"><option value="">Choose</option><option>Now–30 days</option><option>31–90 days</option><option>3–6 months</option><option>6–12 months</option><option>Learning only</option></select></label>
          <label class="wide">Primary need<select required name="intake_category"><option value="">Choose</option><option value="creative-direction">Creative direction</option><option value="genai">GenAI strategy and production</option><option value="media-management">Media management</option><option value="marketing-consulting">Marketing consulting</option><option value="product-strategy">Product strategy</option><option value="creative-technology">Creative technology</option></select></label>
          <label class="wide">The decision or challenge<textarea required name="primary_challenge" rows="5"></textarea></label>
          <label class="wide">Additional context<textarea name="context" rows="3"></textarea></label>
          <label class="wide">Preferred next step<select required name="preferred_next_step"><option>Send the brief only</option><option>Brief plus a working session</option><option>Discuss an advisory engagement</option><option>Discuss a product</option></select></label>
          <label class="consent wide"><input required type="checkbox" name="consent" value="yes" /> I agree that HardMagic may use this information to deliver the requested brief and administer this request.</label>
          <label class="consent wide optional"><input type="checkbox" name="marketing_consent" value="yes" /> Separately, I would like occasional HardMagic research and product updates.</label>
          <div class="cf-turnstile wide" data-sitekey="0x4AAAAAAEOV4a4wcfxluMkv" data-theme="dark" data-action="brief-request"></div>
          <input type="hidden" name="report" value={brief.slug} />
          <input type="hidden" name="source_url" value={`https://hardmagic.com/briefs/${brief.slug}/`} />
          <input type="hidden" name="source_campaign" value="technical-brief-library" />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
          <button class="button" type="submit">Deliver my private edition</button>
        </div>
      </form>
    </section>
  </article>
</BaseLayout>
