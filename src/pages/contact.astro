---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Start a consultation"
  description="Tell HardMagic what decision is waiting on the other side of your brief. We will route the right creative, marketing, GenAI, media, or product conversation."
  turnstile
>
  <article class="contact-intake">
    <section class="contact-intake__opening" aria-labelledby="contact-title">
      <div class="contact-intake__intro">
        <p class="eyebrow dark">Consultation intake · 01 / 03</p>
        <h1 id="contact-title">Name the decision.<br /><em>We’ll shape what happens next.</em></h1>
        <p class="contact-intake__deck">
          A useful first conversation starts before the deliverable. Tell us what is changing, who needs to move,
          and where the decision is stuck. We will bring the right senior point of view to the first reply.
        </p>

        <div class="contact-intake__route-note">
          <p class="contact-intake__label">Starting points</p>
          <p>Creative direction · advertising and marketing · GenAI · media systems and products</p>
        </div>

        <p class="contact-intake__fallback">
          Prefer a direct note?
          <a href="mailto:hello@hardmagic.com">hello@hardmagic.com <span aria-hidden="true">↗</span></a>
        </p>
      </div>

      <div class="contact-intake__form-wrap">
        <div class="contact-intake__form-heading">
          <p class="contact-intake__label">The useful brief</p>
          <h2>Give the question<br /><em>some shape.</em></h2>
          <p>High-level context is enough. We are looking for the mandate, not a polished deck.</p>
        </div>

        <form
          method="post"
          action="https://briefs.hardmagic.com/api/contact-request"
          class="contact-intake__form"
          aria-describedby="contact-privacy"
        >
          <fieldset class="contact-intake__fieldset contact-intake__fieldset--routes">
            <legend>What should we talk about?</legend>
            <p class="contact-intake__hint">Choose the decision edge that feels closest. We will route adjacent needs in review.</p>
            <div class="contact-intake__route-grid">
              <label class="contact-intake__route-option">
                <input type="radio" name="intake_category" value="creative-direction" required />
                <span><strong>Creative direction</strong><small>Make the future unmistakable.</small></span>
              </label>
              <label class="contact-intake__route-option">
                <input type="radio" name="intake_category" value="marketing-consulting" />
                <span><strong>Advertising &amp; marketing</strong><small>Turn market intent into movement.</small></span>
              </label>
              <label class="contact-intake__route-option">
                <input type="radio" name="intake_category" value="genai" />
                <span><strong>GenAI strategy &amp; production</strong><small>Move from interest to an operating decision.</small></span>
              </label>
              <label class="contact-intake__route-option">
                <input type="radio" name="intake_category" value="media-management" />
                <span><strong>Media systems &amp; operations</strong><small>Bring order to the estate and its lifecycle.</small></span>
              </label>
              <label class="contact-intake__route-option">
                <input type="radio" name="intake_category" value="product-strategy" />
                <span><strong>Products &amp; product strategy</strong><small>Give an ambitious product a working shape.</small></span>
              </label>
              <label class="contact-intake__route-option">
                <input type="radio" name="intake_category" value="creative-technology" />
                <span><strong>Creative technology</strong><small>Connect imagination to a durable system.</small></span>
              </label>
            </div>
          </fieldset>

          <div class="contact-intake__field-grid">
            <label>
              <span>Full name</span>
              <input required name="name" autocomplete="name" maxlength="160" />
            </label>
            <label>
              <span>Work email</span>
              <input required type="email" name="email" autocomplete="email" maxlength="320" />
            </label>
            <label>
              <span>Organization</span>
              <input required name="organization" autocomplete="organization" maxlength="200" />
            </label>
            <label>
              <span>Role</span>
              <input required name="role" autocomplete="organization-title" maxlength="120" />
            </label>
            <label class="contact-intake__field--wide">
              <span>What needs to become true?</span>
              <textarea
                required
                name="mandate"
                rows="6"
                maxlength="4000"
                aria-describedby="contact-mandate-hint"
              ></textarea>
              <small id="contact-mandate-hint">A concise mandate, tension, or decision is more useful than an attachment.</small>
            </label>
            <label>
              <span>Decision horizon</span>
              <select required name="decision_horizon">
                <option value="">Choose a horizon</option>
                <option>Now — next 30 days</option>
                <option>31–90 days</option>
                <option>3–6 months</option>
                <option>6–12 months</option>
                <option>Exploring — no date yet</option>
              </select>
            </label>
            <label>
              <span>Preferred next step</span>
              <select required name="preferred_next_step">
                <option value="">Choose a next step</option>
                <option>A 30-minute exploratory conversation</option>
                <option>A working session with the right leads</option>
                <option>An engagement recommendation</option>
                <option>A product or systems discussion</option>
              </select>
            </label>
          </div>

          <p id="contact-privacy" class="contact-intake__privacy">
            Please keep this first note high-level. Do not include confidential material, trade secrets, regulated
            personal information, credentials, or anything you would not want in an intake record.
          </p>

          <label class="contact-intake__consent">
            <input required type="checkbox" name="consent" value="yes" />
            <span>I agree that HardMagic may use this information to respond to my request and administer this conversation.</span>
          </label>
          <label class="contact-intake__consent contact-intake__consent--optional">
            <input type="checkbox" name="marketing_consent" value="yes" />
            <span>Separately, I would like occasional HardMagic research and product updates.</span>
          </label>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAAEOV4a4wcfxluMkv" data-theme="dark" data-size="flexible" data-action="contact-request"></div>

          <input type="hidden" name="source_url" value="https://hardmagic.com/contact/" />
          <input type="hidden" name="source_campaign" value="contact-intake" />
          <div class="contact-intake__trap" aria-hidden="true">
            <label>Leave this field empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
          </div>

          <button class="contact-intake__submit" type="submit">Send the first question <span aria-hidden="true">↗</span></button>
          <p class="contact-intake__submit-note">When the delivery boundary accepts the request, it sends a receipt to the address provided. A human then reviews the mandate before the next step.</p>
        </form>
      </div>
    </section>

    <section class="contact-intake__after" aria-labelledby="next-title">
      <div class="contact-intake__after-heading">
        <p class="eyebrow dark">After you press send · 02 / 03</p>
        <h2 id="next-title">A considered<br /><em>next move.</em></h2>
      </div>
      <ol class="contact-intake__steps">
        <li><span>01</span><div><strong>Private intake</strong><p>Your note is routed to the consultation queue, not published or added to a public feed.</p></div></li>
        <li><span>02</span><div><strong>Human review</strong><p>We read the mandate, decision horizon, and working lane before suggesting who should join.</p></div></li>
        <li><span>03</span><div><strong>Useful reply</strong><p>We respond from a monitored HardMagic address with the clearest next conversation we can offer.</p></div></li>
      </ol>
      <aside class="contact-intake__boundary">
        <p class="contact-intake__label">A small boundary</p>
        <p>We do not need confidential files to decide whether a conversation is useful. Keep the first message safe to share.</p>
        <a href="privacy/">Read the privacy note <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <footer class="contact-intake__close">
      <p class="eyebrow dark">If the form is not your medium · 03 / 03</p>
      <p>Send a high-level note to <a href="mailto:hello@hardmagic.com">hello@hardmagic.com</a>. The same human route applies.</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .contact-intake {
    --contact-line: rgba(242, 233, 223, 0.16);
    --contact-soft: #c5b9c0;
    --contact-mist: #a99ca4;
    overflow: hidden;
    color: var(--bone, #f2e9df);
  }

  .contact-intake__opening {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(52px, 8vw, 150px);
    width: var(--shell);
    min-height: 100svh;
    margin-inline: auto;
    padding-block: clamp(150px, 15vw, 230px) clamp(90px, 10vw, 150px);
  }

  .contact-intake__intro {
    align-self: start;
    padding-top: clamp(10px, 4vw, 68px);
  }

  .contact-intake h1,
  .contact-intake h2 {
    font-family: var(--serif, Georgia, serif);
    font-weight: 400;
  }

  .contact-intake h1 {
    max-width: 720px;
    margin: 0 0 34px;
    font-size: clamp(4rem, 6.8vw, 8.5rem);
    line-height: 0.84;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .contact-intake h1 em,
  .contact-intake h2 em {
    color: var(--signal, #d9325e);
    font-style: italic;
  }

  .contact-intake__deck {
    max-width: 560px;
    margin: 0;
    color: var(--contact-soft);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.65;
  }

  .contact-intake__route-note {
    max-width: 520px;
    margin-top: clamp(50px, 8vw, 105px);
    padding-top: 18px;
    border-top: 1px solid var(--contact-line);
    color: var(--contact-mist);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .contact-intake__route-note p:last-child {
    margin: 0;
  }

  .contact-intake__label {
    margin: 0 0 12px;
    color: var(--signal, #d9325e);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-intake__fallback {
    margin: 30px 0 0;
    color: var(--contact-mist);
    font-size: 0.78rem;
  }

  .contact-intake__fallback a,
  .contact-intake__close a,
  .contact-intake__boundary a {
    color: var(--bone, #f2e9df);
    text-underline-offset: 0.2em;
  }

  .contact-intake__fallback a span,
  .contact-intake__close a::after,
  .contact-intake__boundary a span {
    color: var(--signal, #d9325e);
  }

  .contact-intake__form-wrap {
    align-self: start;
    padding: clamp(24px, 4vw, 58px);
    border: 1px solid rgba(242, 233, 223, 0.24);
    background:
      radial-gradient(circle at 90% 0%, rgba(217, 50, 94, 0.16), transparent 28rem),
      linear-gradient(145deg, rgba(26, 15, 21, 0.96), rgba(10, 7, 9, 0.98));
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.25);
  }

  .contact-intake__form-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 0.7fr);
    gap: 20px 44px;
    align-items: end;
    margin-bottom: 42px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--contact-line);
  }

  .contact-intake__form-heading .contact-intake__label,
  .contact-intake__form-heading h2 {
    grid-column: 1;
  }

  .contact-intake__form-heading .contact-intake__label {
    margin-bottom: -4px;
  }

  .contact-intake__form-heading h2 {
    margin: 0;
    font-size: clamp(2.8rem, 4.6vw, 5.3rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .contact-intake__form-heading > p:last-child {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
    margin: 0;
    color: var(--contact-soft);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .contact-intake__form {
    display: grid;
    gap: 28px;
  }

  .contact-intake__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact-intake__fieldset legend {
    margin-bottom: 7px;
    color: var(--bone, #f2e9df);
    font-size: 1rem;
    font-weight: 600;
  }

  .contact-intake__hint {
    margin: 0 0 15px;
    color: var(--contact-mist);
    font-size: 0.78rem;
  }

  .contact-intake__route-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .contact-intake__route-option {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    min-height: 88px;
    padding: 14px;
    border: 1px solid var(--contact-line);
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .contact-intake__route-option:hover {
    border-color: rgba(217, 50, 94, 0.7);
    background: rgba(217, 50, 94, 0.08);
  }

  .contact-intake__route-option:has(input:checked) {
    border-color: var(--signal, #d9325e);
    background: rgba(217, 50, 94, 0.14);
  }

  .contact-intake__route-option input {
    width: 16px;
    height: 16px;
    margin: 2px 0 0;
    accent-color: var(--signal, #d9325e);
  }

  .contact-intake__route-option span {
    display: grid;
    gap: 5px;
  }

  .contact-intake__route-option strong {
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .contact-intake__route-option small,
  .contact-intake__field-grid small {
    color: var(--contact-mist);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    text-transform: none;
  }

  .contact-intake__field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }

  .contact-intake__field-grid label {
    display: grid;
    gap: 8px;
    min-width: 0;
    color: var(--contact-soft);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-intake__field-grid .contact-intake__field--wide {
    grid-column: 1 / -1;
  }

  .contact-intake__field-grid input,
  .contact-intake__field-grid select,
  .contact-intake__field-grid textarea {
    width: 100%;
    min-width: 0;
    padding: 13px 14px;
    border: 1px solid rgba(242, 233, 223, 0.26);
    border-radius: 0;
    background: rgba(4, 3, 4, 0.62);
    color: var(--bone, #f2e9df);
    font: 400 1rem/1.45 var(--display, Raleway, sans-serif);
  }

  .contact-intake__field-grid input,
  .contact-intake__field-grid select {
    min-height: 50px;
  }

  .contact-intake__field-grid textarea {
    min-height: 150px;
    resize: vertical;
  }

  .contact-intake__field-grid input::placeholder,
  .contact-intake__field-grid textarea::placeholder {
    color: var(--contact-mist);
  }

  .contact-intake__field-grid input:focus,
  .contact-intake__field-grid select:focus,
  .contact-intake__field-grid textarea:focus {
    border-color: var(--signal, #d9325e);
    outline: 0;
  }

  .contact-intake__privacy {
    margin: 0;
    padding: 15px 17px;
    border-left: 3px solid var(--signal, #d9325e);
    background: rgba(217, 50, 94, 0.08);
    color: var(--contact-soft);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .contact-intake__consent {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 11px;
    align-items: start;
    margin: 0;
    color: var(--contact-soft);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .contact-intake__consent--optional {
    padding-top: 17px;
    border-top: 1px solid var(--contact-line);
    color: var(--contact-mist);
  }

  .contact-intake__consent input {
    width: 16px;
    height: 16px;
    margin: 2px 0 0;
    accent-color: var(--signal, #d9325e);
  }

  .contact-intake__form .cf-turnstile {
    max-width: 100%;
    overflow: hidden;
    min-height: 65px;
  }

  .contact-intake__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-intake__trap label {
    display: block;
  }

  .contact-intake__submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 58px;
    padding: 0 18px 0 20px;
    border: 1px solid var(--signal, #d9325e);
    background: var(--signal, #d9325e);
    color: #fff;
    font: 800 0.7rem/1 var(--display, Raleway, sans-serif);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .contact-intake__submit span {
    font-size: 1.3rem;
    line-height: 1;
  }

  .contact-intake__submit:hover {
    border-color: var(--bone, #f2e9df);
    background: var(--bone, #f2e9df);
    color: var(--abyss, #070506);
  }

  .contact-intake__submit-note {
    margin: -12px 0 0;
    color: var(--contact-mist);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .contact-intake__after {
    display: grid;
    grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1fr) minmax(220px, 0.55fr);
    gap: clamp(35px, 6vw, 100px);
    width: var(--shell);
    margin-inline: auto;
    padding-block: clamp(90px, 11vw, 170px);
    border-top: 1px solid var(--contact-line);
  }

  .contact-intake__after-heading h2 {
    margin: 0;
    font-size: clamp(3rem, 5vw, 6rem);
    line-height: 0.87;
    letter-spacing: -0.06em;
  }

  .contact-intake__steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-intake__steps li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--contact-line);
  }

  .contact-intake__steps li:last-child {
    border-bottom: 1px solid var(--contact-line);
  }

  .contact-intake__steps li > span {
    color: var(--signal, #d9325e);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .contact-intake__steps strong {
    font-size: 1.05rem;
  }

  .contact-intake__steps p {
    margin: 6px 0 0;
    color: var(--contact-soft);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .contact-intake__boundary {
    align-self: start;
    padding: 20px;
    border: 1px solid rgba(217, 50, 94, 0.45);
    background: rgba(217, 50, 94, 0.08);
  }

  .contact-intake__boundary > p:not(.contact-intake__label) {
    margin: 0 0 22px;
    color: var(--contact-soft);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .contact-intake__boundary a {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-intake__close {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 30px;
    width: var(--shell);
    margin-inline: auto;
    padding-block: 24px 80px;
    border-top: 1px solid var(--contact-line);
    color: var(--contact-mist);
  }

  .contact-intake__close .eyebrow {
    flex: 0 0 auto;
    margin: 0;
  }

  .contact-intake__close p:last-child {
    margin: 0;
    font-size: 0.86rem;
  }

  @media (max-width: 1100px) {
    .contact-intake__opening {
      grid-template-columns: minmax(240px, 0.58fr) minmax(0, 1.42fr);
      gap: 42px;
    }

    .contact-intake__form-wrap {
      padding: 28px;
    }

    .contact-intake__after {
      grid-template-columns: minmax(220px, 0.6fr) minmax(0, 1fr);
    }

    .contact-intake__boundary {
      grid-column: 2;
    }
  }

  @media (max-width: 820px) {
    .contact-intake__opening,
    .contact-intake__after {
      grid-template-columns: 1fr;
    }

    .contact-intake__opening {
      min-height: auto;
    }

    .contact-intake__intro {
      padding-top: 0;
    }

    .contact-intake__route-note {
      margin-top: 44px;
    }

    .contact-intake__form-heading {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .contact-intake__form-heading .contact-intake__label,
    .contact-intake__form-heading h2,
    .contact-intake__form-heading > p:last-child {
      grid-column: 1;
      grid-row: auto;
    }

    .contact-intake__after {
      gap: 44px;
    }

    .contact-intake__boundary {
      grid-column: auto;
      max-width: 560px;
    }
  }

  @media (max-width: 560px) {
    .contact-intake__opening {
      padding-block: 145px 72px;
    }

    .contact-intake h1 {
      font-size: clamp(3.35rem, 16vw, 5rem);
    }

    .contact-intake__form-wrap {
      padding: 20px 15px;
    }

    .contact-intake__form-heading {
      margin-bottom: 30px;
      padding-bottom: 23px;
    }

    .contact-intake__form-heading h2 {
      font-size: 3rem;
    }

    .contact-intake__route-grid,
    .contact-intake__field-grid {
      grid-template-columns: 1fr;
    }

    .contact-intake__route-option {
      min-height: 74px;
    }

    .contact-intake__field-grid .contact-intake__field--wide {
      grid-column: auto;
    }

    .contact-intake__after {
      padding-block: 80px;
    }

    .contact-intake__after-heading h2 {
      font-size: 3.5rem;
    }

    .contact-intake__close {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      padding-bottom: 55px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-intake__route-option,
    .contact-intake__submit {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .contact-intake__form-wrap,
    .contact-intake__route-option,
    .contact-intake__boundary {
      border: 1px solid CanvasText;
      background: Canvas;
    }

    .contact-intake__submit {
      border: 2px solid ButtonText;
      background: ButtonFace;
      color: ButtonText;
    }
  }
</style>
