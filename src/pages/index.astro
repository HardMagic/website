---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/sections/Marquee.astro';
import CaseCard from '../components/portfolio/CaseCard.astro';
import { caseStudies } from '../data/portfolio';
import heroDesktop from '../assets/editorial/hardmagic-future-command-desktop.avif';
import heroTablet from '../assets/editorial/hardmagic-future-command-tablet.avif';
import heroMobile from '../assets/editorial/hardmagic-future-command-mobile.avif';
import mediaAlchemy from '../assets/editorial/media-alchemy-ritual.avif';
import generativeOperations from '../assets/editorial/generative-operations-4k.avif';
import audienceDreamfield from '../assets/editorial/audience-dreamfield-2035.avif';
import dreamSpecimen from '../assets/editorial/dream-media-specimen-4k.avif';
import '../styles/home-current.css';

const featuredCase = caseStudies[1] ? caseStudies[1] : caseStudies[0];

const mediaReels = [
  {
    image: mediaAlchemy,
    title: 'Creative ritual as production system',
    category: 'Creative Systems',
    description: 'A media ritual framework for category-defining launches where audience emotion and production rigor move together.',
    href: 'services/creative-direction/',
    cta: 'Open creative path',
    alt: 'Abstract visual of a luminous ritual-like formation blending cinematic textures and symbolic motion graphics.',
  },
  {
    image: generativeOperations,
    title: 'Generative operations at enterprise scale',
    category: 'GenAI Operations',
    description: 'Design of scalable creative infrastructure for enterprise brands, media studios, and transformation teams.',
    href: 'services/genai-strategy/',
    cta: 'See our operating model',
    alt: 'Futuristic media operations interface with flowing cables and luminous media nodes.',
  },
  {
    image: audienceDreamfield,
    title: 'Audience forecasting for the next decade',
    category: 'Signal Intelligence',
    description: 'Audience behavior mapped visually into campaign planning language that leaders can execute with speed.',
    href: 'horizon/',
    cta: 'Enter Horizon 2035',
    alt: 'Dreamlike audience landscape with reflective architecture and human silhouettes.',
  },
];
---

<BaseLayout title="Shape What the World Sees Next" description="HardMagic is an independent media conglomerate built for global brands, film studios, and category-defining companies leading advertising, media creation, and GenAI transformation.">
  <div class="narrative-field">
    <div class="cosmic-atmosphere" aria-hidden="true">
      <i class="cosmic-dust dust-near"></i><i class="cosmic-dust dust-far"></i>
      <span class="cosmic-orbit orbit-one"></span><span class="cosmic-orbit orbit-two"></span>
      <svg class="infinity-constellation" viewBox="0 0 1200 560">
        <defs><filter id="infinity-glow"><feGaussianBlur stdDeviation="8" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
        <path class="infinity-haze" d="M92 280C92 86 326 68 497 229c35 33 68 68 103 103 35-35 68-70 103-103C874 68 1108 86 1108 280S874 492 703 331c-35-33-68-68-103-103-35 35-68 70-103 103C326 492 92 474 92 280Z"/>
        <path class="infinity-light" pathLength="1" d="M92 280C92 86 326 68 497 229c35 33 68 68 103 103 35-35 68-70 103-103C874 68 1108 86 1108 280S874 492 703 331c-35-33-68-68-103-103-35 35-68 70-103 103C326 492 92 474 92 280Z"/>
      </svg>
    </div>
    <svg class="narrative-thread" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
      <path class="thread-a" d="M790 0 C940 70 910 126 710 171 S160 257 278 342 S925 418 719 508 S122 598 319 684 S912 778 654 856 S246 930 161 1000" />
      <path class="thread-b" d="M812 0 C960 74 930 133 731 178 S184 264 299 349 S948 425 739 515 S144 605 341 691 S934 785 676 863 S267 937 183 1000" />
    </svg>

    <section class="current-hero">
      <picture class="current-hero-art">
        <source media="(max-width: 620px)" srcset={heroMobile.src} width="1200" height="1498" />
        <source media="(max-width: 1100px)" srcset={heroTablet.src} width="1920" height="1080" />
        <img src={heroDesktop.src} width="3840" height="1920" alt="AI-generated campaign scene of creative directors orchestrating a monumental film set of sculptural fabric, cameras, and practical light." loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <div class="current-hero-shade"></div>
      <div class="shell current-hero-copy">
        <p class="eyebrow">HardMagic / global media, campaign systems, and GenAI at enterprise scale</p>
        <h1>Shape what the world<br /><em>sees next.</em></h1>
        <p>HardMagic is built to give global brands, film studios, and category-defining companies one senior direction room for media, strategy, and generative execution.</p>
        <div class="hero-actions">
          <a class="button" href="contact/">Commission the next move</a>
          <a class="text-link hero-work-link" href="#route-entries">Choose a decision path <b>↗</b></a>
          <a class="text-link hero-signal-link" href="#close">Go deeper now <b>↘</b></a>
        </div>
      </div>
      <div class="current-proof-rail" aria-label="Who HardMagic moves" tabindex="0">
        <span><b>01</b> Global brands</span><span><b>02</b> Film + entertainment</span><span><b>03</b> Venture-backed leaders</span><span><b>04</b> Industry transformation</span>
      </div>
      <p class="hero-disclosure">HardMagic-directed generative campaign image · not a facility, client, or product record</p>
    </section>

    <Marquee />

    <section class="home-identity shell section-pad">
      <div>
        <p class="eyebrow dark">Who we are / how we work</p>
        <h2>Independent media conglomerate.<br /><em>One room. One outcome.</em></h2>
      </div>
      <div class="home-identity-grid">
        <div class="home-identity-copy">
          <p>HardMagic brings creative direction, growth leadership, and media systems together in one room. We serve board-level business needs and production decisions that must be coherent across audience, platform, and brand memory.</p>
          <p>Start with the decision. Bring your market, category, and capability gap first. We help define the path from thesis to execution.</p>
          <div class="home-identity-actions">
            <a class="button dark-button" href="company/">Explore the company</a>
            <a class="text-link" href="company/operating-model/">How we engage <b>↗</b></a>
            <a class="text-link" href="services/">See all service lines <b>↗</b></a>
          </div>
        </div>
        <ol class="home-identity-notes">
          <li><span>01 · Where we lead</span><p>Creative and growth leadership for enterprise media-defining decisions.</p></li>
          <li><span>02 · Why now</span><p>Markets move faster than coherence when systems lag creative decisions.</p></li>
          <li><span>03 · What we deliver</span><p>Campaign systems, GenAI studios, and production structures designed for trust and speed.</p></li>
        </ol>
      </div>
    </section>

    <section id="route-entries" class="home-route shell section-pad">
      <div>
        <p class="eyebrow dark">Start where the need is real</p>
        <h2>Decision-led pathways.<br /><em>Choose one lane.</em></h2>
      </div>
      <div class="home-route-grid">
        <a class="home-route-card" href="services/campaign-production/">
          <span>01 / Advertising & campaigns</span>
          <strong>Live markets, growth pressure, global attention</strong>
          <p>Campaign systems, launch playbooks, and channel-agnostic expression designed for category visibility.</p>
          <b>Open campaign lane <span aria-hidden="true">↗</span></b>
        </a>
        <a class="home-route-card" href="services/creative-direction/">
          <span>02 / Creative authority</span>
          <strong>Position, narrative, brand logic</strong>
          <p>Direction that links your category story, visual system, and audience trust under one brief.</p>
          <b>Open creative lane <span aria-hidden="true">↗</span></b>
        </a>
        <a class="home-route-card" href="services/genai-strategy/">
          <span>03 / Enterprise AI</span>
          <strong>Scale where it is still controllable</strong>
          <p>Governance-first adoption for production, teams, and long-lived media assets.</p>
          <b>Open growth lane <span aria-hidden="true">↗</span></b>
        </a>
      </div>
    </section>

    <section class="home-media-enrichment shell section-pad">
      <div class="home-media-enrichment-head">
        <p class="eyebrow dark">Media-rich evidence</p>
        <h2>Selected visual worlds in motion.</h2>
        <p class="home-media-enrichment-intro">HardMagic builds for brands and studios where direction, distribution, and proof are inseparable. Browse how we shape campaigns that move culture and conversion together.</p>
      </div>
      <div class="home-media-grid">
        {
          mediaReels.map((item) => (
            <a class="home-media-card" href={item.href}>
              <Picture
                src={item.image}
                alt={item.alt}
                widths={[640, 960, 1400]}
                sizes="(min-width: 1200px) 33.333vw, (min-width: 720px) 50vw, 100vw"
                formats={['avif']}
                loading="lazy"
              />
              <div class="home-media-copy">
                <span>{item.category}</span>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
                <b>{item.cta} <span aria-hidden="true">↗</span></b>
              </div>
            </a>
          ))
        }
      </div>
      <div class="home-media-enrichment-actions">
        <a class="button dark-button" href="portfolio/">Explore the full studio portfolio</a>
        <a class="text-link" href="insights/">Read latest media signal notes <b>↗</b></a>
      </div>
    </section>

    <section class="home-compact-work section-pad">
      <div class="shell home-compact-work-head">
        <p class="eyebrow dark">Proof point</p>
        <h2>Selected work we can discuss right away.</h2>
      </div>
      <div class="shell home-mini-grid">{featuredCase ? <CaseCard study={featuredCase} index={0} /> : null}</div>
      <div class="section-end shell"><a class="button dark-button" href="portfolio/">See full portfolio and case approach</a></div>
    </section>

    <figure class="future-field">
      <Picture src={dreamSpecimen} alt="A luminous waveform passes through film, paper, and a small projection apparatus on a black field." formats={[]} fallbackFormat="avif" width={1920} widths={[720, 1200, 1920]} sizes="100vw" />
      <span class="future-field-shade" aria-hidden="true"></span>
      <div class="future-field-copy shell">
        <p class="eyebrow">Dispatch from 2035</p>
        <h2>See the signal.<br /><em>Choose the route.</em></h2>
        <p>HardMagic translates global media shifts into decision-ready direction and execution architecture.</p>
        <a class="text-link" href="horizon/">Enter Horizon 2035 <b>↗</b></a>
      </div>
      <figcaption>HardMagic-directed conceptual media specimen · scenario artwork, not a forecast</figcaption>
    </figure>

    <section id="close" class="current-close">
      <div>
        <p class="eyebrow">Independent media conglomerate · global experience · 25+ years of practice</p>
        <h2>Move your company.<br />before the signal fades.</h2>
        <p>Bring a decision, not a wishlist. We will help you define the position, the system, and execution sequence that turns strategy into visible media advantage.</p>
        <div>
          <a class="button" href="contact/">Start a consulting intake</a>
          <a class="text-link" href="briefs/">Read the private brief library <b>↗</b></a>
          <a class="text-link" href="insights/">Read recent insights <b>↗</b></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
